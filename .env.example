# ==========================================
# Webhook Delivery Platform - Environment Configuration
# ==========================================

# Server Port (default: 8085)
PORT=8085

# Database Configuration (PostgreSQL)
DATABASE_URL=jdbc:postgresql://localhost:5432/webhook_platform
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=password

# Security & API Key
WEBHOOK_API_KEY=wh_live_adminkey_2026_secret
WEBHOOK_ALLOW_LOOPBACK=true

# Delivery Engine Settings
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_CONNECT_TIMEOUT_MS=3000
WEBHOOK_READ_TIMEOUT_MS=5000
WEBHOOK_WORKER_POLL_MS=5000
WEBHOOK_WORKER_BATCH_SIZE=50
